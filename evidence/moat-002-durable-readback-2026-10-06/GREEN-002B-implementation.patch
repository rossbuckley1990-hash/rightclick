+            !pieces[0].contains("{"),
+            !pieces[0].contains("}"),
+            !pieces[1].contains("{"),
+            !pieces[1].contains("}")
+        else {
+            return nil
+        }
+
+        let argumentsSchema:
+            [String: Any] = [
+                "type":
