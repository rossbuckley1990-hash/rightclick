+                "required": [
+                    name
+                ],
+                "properties": [
+                    name: [
+                        "type":
+                            "string"
+                    ]
+                ],
+            ]
+
+        return parseClosedJSONStringObjectSchema(
+            argumentsSchema
+        )
+    }
