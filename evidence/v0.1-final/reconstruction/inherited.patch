+    private struct ServiceInvocation {
+        var ok = false
+        var finished = false
+        var changeCountAfter = 0
+    }
+
+    /// Runs NSPerformService on the main thread inside a running NSApplication.
+    /// A command-line run loop is not the same lifecycle as a native Services client.
+    private static func invokeService(named name: String, pasteboard: NSPasteboard, changeCountBefore: Int) -> ServiceInvocation {
+        let call = {
+            let ok = NSPerformService(name, pasteboard)
+            var invocation = ServiceInvocation()
+            invocation.ok = ok
+            invocation.finished = true
+            invocation.changeCountAfter = pasteboard.changeCount
+            if ok && invocation.changeCountAfter == changeCountBefore {
+                ExecutionLog.write("service pasteboard retained after NSPerformService returned without a pasteboard result")
+                retain(pasteboard, seconds: 10)
+            }
+            return invocation
+        }
+        if Thread.isMainThread && NSApplication.shared.isRunning {
+            return call()
+        }
+        let app = NSApplication.shared
+        if app.activationPolicy() == .prohibited {
+            app.setActivationPolicy(.accessory)
+        }
+        let box = ServiceCallBox()
+        var invocation = ServiceInvocation()
+        final class ServiceApplication: NSObject, NSApplicationDelegate {
+            var work: (() -> Void)?
+            func applicationDidFinishLaunching(_ notification: Notification) {
+                work?()
+            }
+        }
+        let starter = ServiceApplication()
+        starter.work = {
+            invocation = call()
+            box.finish(invocation.ok)
+            DispatchQueue.main.async {
+                app.stop(nil)
+                if let event = NSEvent.otherEvent(
+                    with: .applicationDefined,
+                    location: .zero,
+                    modifierFlags: [],
+                    timestamp: 0,
+                    windowNumber: 0,
+                    context: nil,
+                    subtype: 0,
+                    data1: 0,
+                    data2: 0
+                ) {
+                    app.postEvent(event, atStart: true)
+                }
+            }
+        }
+        let previousDelegate = app.delegate
+        app.delegate = starter
+        if Thread.isMainThread {
+            app.run()
+        } else {
+            DispatchQueue.main.async {
+                app.run()
+            }
+            let deadline = Date().addingTimeInterval(40)
+            while !box.done && Date() < deadline {
+                RunLoop.current.run(mode: .default, before: Date().addingTimeInterval(0.05))
+            }
+        }
+        app.delegate = previousDelegate
+        if !box.done {
+            invocation.finished = false
+            invocation.changeCountAfter = pasteboard.changeCount
+        }
+        return invocation
+    }
+
