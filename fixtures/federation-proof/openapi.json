{
  "openapi": "3.0.3",
  "info": {
    "title": "RIGHTCLICK Federation Remote Proof Provider",
    "version": "1.0.0"
  },
  "paths": {
    "/repos/rossbuckley1990-hash/rightclick/git/blobs/{blob}": {
      "get": {
        "operationId": "readFederationProof",
        "summary": "Read federation proof",
        "parameters": [
          {
            "name": "blob",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable Git blob response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
